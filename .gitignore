main-blx.bib

# Large delivery-bundle zips (frozen snapshots of tracked content, not source)
*.zip

# Unrelated reference theses (not part of AURA-MAS; removed from the repo,
# ignored so a stray local extraction is never re-added)
/engineerthesis/

# Streamlit / misc caches
.streamlit/

