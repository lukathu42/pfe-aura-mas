# Copy to .env.local and adjust if Mosquitto/Redis aren't on their
# docker-compose.yml defaults. Server-side only (route handlers) — never
# exposed to the browser.
AURA_MQTT_URL=mqtt://localhost:1883
AURA_REDIS_URL=redis://localhost:6379

# Scenario used when the console isn't given ?scenario=<name> in the URL.
# Must match a data/../scenarios/<name>.json filename (without extension).
AURA_SCENARIO=combined_audio_video_01
